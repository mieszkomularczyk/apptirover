# === Base image with Ultralytics + PyTorch + CUDA ===
FROM base:latest

# --- Environment setup ---
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    ROS_DISTRO=humble \
    WORKSPACE=/workspace

WORKDIR ${WORKSPACE}

# Copy full source code (breaks cache only when source changes)
COPY src/ ${WORKSPACE}/src/

# --- Build all ROS2 packages ---
RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && colcon build --symlink-install --base-paths src --packages-skip yolo"
RUN bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && colcon build --symlink-install --base-paths src --packages-select yolo --cmake-args -DCMAKE_EXE_LINKER_FLAGS=\"-Wl,--allow-shlib-undefined\""

# --- Setup entrypoint (ROS environment + user script) ---
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]