<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>osd</name>
  <version>2.0.0</version>
  <description>C++ OSD compositor that renders Foxglove ImageAnnotations onto camera frames with zero-copy IPC support.</description>
  <maintainer email="maciej.kaca@apptimia.com">Maciej Kaca</maintainer>
  <author email="maciej.kaca@apptimia.com">Maciej Kaca</author>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>foxglove_msgs</depend>
  <depend>cv_bridge</depend>

  <build_depend>libopencv-dev</build_depend>
  <exec_depend>libopencv-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
