<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tracker</name>
  <version>1.0.0</version>
  <description>Multi-algorithm object tracker (BYTETracker/BOTSORT/etc) that assigns persistent IDs to YOLO detections.</description>
  <maintainer email="maciej.kaca@apptimia.com">Maciej Kaca</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>vision_msgs</depend>
  <depend>dog_msgs</depend>
  <depend>foxglove_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
